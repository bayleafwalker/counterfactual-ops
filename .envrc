export AUDITCTL_ARTIFACTS_ROOT="$PWD"
export AUDITCTL_DB="$PWD/.auditctl/auditctl.db"
# Workstation selection; other hosts supply their independently validated profile.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE="${SPRINTCTL_VUORO_PROFILE:-/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json}"
unset SPRINTCTL_URL
export KCTL_DB="$PWD/.kctl/kctl.db"
source_env_if_exists .envrc.local
